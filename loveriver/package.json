{
  "name": "loveriver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loveriver (LVR): inflationary token with in-token fees and a rotatable fee wallet, plus wallet tooling",
  "scripts": {
    "selftest": "node tools/gen-wallets.mjs --selftest",
    "wallets": "node tools/gen-wallets.mjs",
    "fund": "node tools/fund.mjs",
    "topup": "node tools/topup.mjs",
    "clock": "node tools/mint-clock.mjs",
    "ledger": "node tools/mint-ledger.mjs --show",
    "selftest:schedule": "node tools/mint-window.mjs --selftest",
    "selftest:ledger": "node tools/mint-ledger.mjs --selftest",
    "watch": "node tools/purge-watch.mjs --status",
    "selftest:watch": "node tools/purge-watch.mjs --selftest",
    "audit": "node tools/mint-audit.mjs",
    "selftest:audit": "node tools/mint-audit.mjs --selftest",
    "restore": "node tools/restore-wallets.mjs",
    "selftest:restore": "node tools/restore-wallets.mjs --selftest",
    "backup": "node tools/repo-backup.mjs",
    "selftest:backup": "node tools/repo-backup.mjs --selftest",
    "deploy:record": "node tools/record-deployment.mjs",
    "selftest:deployments": "node tools/record-deployment.mjs --selftest",
    "selftest:fund": "node tools/fund.mjs --selftest",
    "selftest:topup": "node tools/topup.mjs --selftest"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  }
}
