#!/bin/sh
# Pre-commit gate for the Loveriver tools.
#
# Every `selftest*` script in loveriver/package.json runs before a commit is allowed, but only for
# a commit that stages something under loveriver/, regtest/ or this directory - see the scope
# check below.
#
# A commit that stages mainnet/ is gated too, but by a different check: mainnet/preflight.sh
# --selftest. The tool selftests exercise loveriver/tools and cannot say anything about a batch
# file; what can go wrong there is offline, and it is what that selftest asserts - the batch's own
# arithmetic, the rune name and the postage budget, against the copies preflight.sh carries. It
# costs a fraction of a second, so a mainnet-only commit is never asked to spend 25 seconds on a
# suite that cannot fail for it.
# Those are the only executable proof that the tooling behaves - the key derivation, the mint
# ledger, the clock window, the purge watch, the chain audit, the wallet restore, the repo backup,
# the deployment record and the funder - and a commit that breaks one of them is exactly the change
# worth catching before it becomes history.
#
# The list is discovered from package.json, not written here, so a new tool with a selftest is
# gated the moment its script exists. All nine currently take about 25 seconds together and
# reach no network.
#
# One more gate has no selftest of its own and runs on every commit, scoped or not:
# deployments.json must match the newest deploy broadcast. A redeploy nobody ran `npm run
# deploy:record` after leaves the audit, the top-up and the funder talking confidently to the
# previous token, which no test would notice - the record is right about a token that is no longer
# the one deployed. It cannot live behind the scope test: a redeploy writes only to broadcast/,
# which git ignores, so the commit that follows one stages nothing under loveriver/.
#
# If the gate cannot run it refuses instead of passing: node_modules missing means the tests
# cannot import ethers, and a silent pass would be worse than a blocked commit. git commit
# --no-verify is the deliberate, one-off bypass.
#
# This file is only a gate where git has been told to use it. core.hooksPath lives in the
# repository's local config, which no commit can carry, so a fresh clone has no gate at all until
#   git config core.hooksPath .githooks
# is run there - loveriver/package.json does it from its "prepare" script, so npm install is
# normally enough. Worth knowing before trusting a clone that quietly commits anything.
set -u

# A refusal is a line that begins "  REFUSED: " and exits 2, the same shape the deploy scripts in
# the sibling repository use, so a caller or a CI step can tell "the gate said no" from "the gate
# fell over" - an unhandled error still exits 1, and only a refusal exits 2. Each refusal keeps its
# own sentence and its own next step, so the output names which of them fired.
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "  REFUSED: not inside a git work tree, so there is nothing to gate." >&2
  exit 2
}
app="$root/loveriver"

if [ ! -f "$app/package.json" ]; then
  echo "pre-commit: no loveriver/package.json under $root; nothing to gate" >&2
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "  REFUSED: node is not on PATH, so neither the record check nor the selftests can run." >&2
  exit 2
fi

# The record check, before anything is scoped out. --check exits 1 when deployments.json disagrees
# with the newest broadcast and 0 when it agrees; with no broadcast at all it exits 0 and says it
# skipped, because a machine that never deployed has nothing to be stale against. It needs no
# node_modules (ethers is imported only once an artifact is actually read), costs about a fifth of
# a second, and any other non-zero means it could not run - refused, not passed, because a gate
# that cannot see must not claim the record is current.
echo "pre-commit: deployments.json against the newest broadcast" >&2
record=$(cd "$app" && node tools/record-deployment.mjs --check 2>&1)
record_status=$?
if [ "$record_status" -ne 0 ]; then
  echo "  FAIL  deployments.json (exit $record_status)" >&2
  printf '%s\n' "$record" | tail -12 | sed 's/^/        /' >&2
  echo "" >&2
  echo "  REFUSED: deployments.json disagrees with the newest broadcast, or the check could not run (exit $record_status); the commit was not created." >&2
  echo "           cd loveriver && npm run deploy:record -- --chain <id>   then commit again" >&2
  echo "           (the id is in the FAIL output above; with one chain it is the only one listed)" >&2
  exit 2
fi
printf '  ok    %s\n' "$(printf '%s' "$record" | tail -1 | sed 's/^ *//')" >&2

# Scope. The selftests exercise loveriver/tools, and regtest/ is what those tools run against:
# chain.sh, selftest.sh and the ord scripts are the chain the funder, the top-up and the deployment
# record talk to, so a change there can break a tool without touching a line of it - the breakage a
# commit that only touched regtest/ used to walk straight past. A commit that stages only
# threads/ or a top-level note still cannot, and spending 25 seconds on a gate that
# cannot fail is how people learn to reach for --no-verify. The gate skips those commits and says
# so - out loud, with the paths it saw - because a gate that goes quiet without explanation is
# indistinguishable from one that is not installed.
staged=$(git diff --cached --name-only 2>/dev/null || true)

# The mainnet gate, before the scope test can skip it. It is preflight's own --selftest rather than
# a second copy of the same checks here: the rune name and the postage budget are read from the
# script that uses them, and the same command can be run by hand before a release or from CI. It
# needs no bitcoind, no ord and no network - which is the whole reason it can live in a hook, where
# the six real checks cannot.
if printf '%s\n' "$staged" | grep -qE '^mainnet/'; then
  echo "pre-commit: mainnet run files, mainnet/preflight.sh --selftest" >&2
  mainnet_out=$(cd "$root/mainnet" && bash preflight.sh --selftest 2>&1)
  mainnet_status=$?
  if [ "$mainnet_status" -ne 0 ]; then
    printf '%s\n' "$mainnet_out" | tail -12 | sed 's/^/        /' >&2
    echo "" >&2
    echo "  REFUSED: mainnet/preflight.sh --selftest failed (exit $mainnet_status); the commit was not created." >&2
    echo "           Fix batch.yaml, or the copies of RUNE_NAME and POSTAGE_SATS in preflight.sh," >&2
    echo "           then commit again (or bypass once with: git commit --no-verify)" >&2
    exit 2
  fi
  printf '%s\n' "$mainnet_out" | grep -E '^  ok ' >&2 || true
fi

if ! printf '%s\n' "$staged" | grep -qE '^(loveriver/|regtest/|\.githooks/)'; then
  echo "pre-commit: SKIPPED - no staged path under loveriver/, regtest/ or .githooks/, so the tool selftests were not run." >&2
  if [ -z "$staged" ]; then
    echo "            nothing is staged at all (an empty or amended commit); the selftests will run for the next commit that touches those paths." >&2
  else
    echo "            staged, outside those paths: $(printf '%s' "$staged" | head -3 | tr '\n' ' ')" >&2
  fi
  if printf '%s\n' "$staged" | grep -qE '^mainnet/'; then
    echo "            mainnet/ was gated above by preflight --selftest; the tool suite is not run for it." >&2
  fi
  exit 0
fi

if [ ! -d "$app/node_modules" ]; then
  echo "  REFUSED: $app/node_modules is missing, so the selftests cannot run." >&2
  echo "           cd loveriver && npm install   (then commit again)" >&2
  exit 2
fi

names=$(node -e '
const pkg = require(process.argv[1]);
const names = Object.keys(pkg.scripts || {}).filter((name) => /^selftest/.test(name));
if (names.length === 0) process.exit(3);
process.stdout.write(names.join("\n"));
' "$app/package.json")
discovered=$?
if [ "$discovered" -eq 3 ]; then
  echo "pre-commit: no selftest* scripts in loveriver/package.json; nothing to gate" >&2
  exit 0
elif [ "$discovered" -ne 0 ]; then
  echo "  REFUSED: could not read the selftest list from $app/package.json (exit $discovered)." >&2
  exit 2
fi

total=0
failed=0
echo "pre-commit: loveriver tool selftests" >&2

# Heredoc rather than a pipe so npm cannot swallow the loop's stdin or its exit status.
while IFS= read -r name; do
  [ -n "$name" ] || continue
  total=$((total + 1))
  started=$(date +%s)
  output=$(cd "$app" && npm run --silent "$name" 2>&1)
  status=$?
  elapsed=$(( $(date +%s) - started ))
  if [ "$status" -eq 0 ]; then
    printf '  ok    %-18s %2ss\n' "$name" "$elapsed" >&2
  else
    failed=$((failed + 1))
    printf '  FAIL  %-18s %2ss (exit %s)\n' "$name" "$elapsed" "$status" >&2
    printf '%s\n' "$output" | tail -25 | sed 's/^/        /' >&2
  fi
done <<EOF
$names
EOF

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "  REFUSED: $failed of $total selftests failed; the commit was not created." >&2
  echo "           Fix the tool, or bypass once with: git commit --no-verify" >&2
  exit 2
fi

echo "  all $total passed" >&2
exit 0
